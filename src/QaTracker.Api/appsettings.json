{
  "ConnectionStrings": {
    "QaTracker": "Server=.\\SQLEXPRESS;Database=QaTracker;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=False"
  },
  "Database": {
    "SeedOnStartup": false
  },
  "Auth": {
    "Issuer": "qa-tracker",
    "Audience": "qa-tracker",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Storage": {
    "Root": "App_Data/attachments"
  },
  "RateLimiting": {
    "LoginPermitLimit": 10
  },
  "Seed": {
    "AdminUserName": "admin",
    "AdminEmail": "admin@qatracker.local",
    "AdminFullName": "Administrator"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/qa-tracker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
