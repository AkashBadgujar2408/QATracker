{
  "Database": {
    "SeedOnStartup": true
  },
  "Email": {
    "Enabled": true,
    "SendIntervalSeconds": 5,
    "Smtp": {
      "Host": "localhost",
      "Port": 2525
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Information"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  }
}
