<?xml version="1.0" encoding="utf-8"?>
<!-- IIS hosting (ADR-042). dotnet publish fills in processPath/arguments; everything else is kept as written. -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\QaTracker.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
      <!-- SignalR (/hubs/tracker) needs the IIS WebSocket Protocol feature. -->
      <webSocket enabled="true" />
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 60 MB: five 10 MB attachments (51 MB request) and the 30 MB legacy workbook; the API checks exact limits. -->
          <requestLimits maxAllowedContentLength="62914560" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
